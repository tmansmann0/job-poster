# OpenRouter API key for GPT-5-mini:
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=gpt-5-mini

# Indeed credentials (client credentials flow):
INDEED_CLIENT_ID=your-indeed-client-id
INDEED_CLIENT_SECRET=your-indeed-client-secret

# Google service account JSON (base64 or JSON string)
GOOGLE_SERVICE_ACCOUNT_JSON=your-service-account-json
