<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= title %></title>
  <style>
    :root {
      color-scheme: light dark;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0f172a;
      color: #e2e8f0;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(160deg, rgba(30, 64, 175, 0.85), rgba(14, 116, 144, 0.85));
    }

    header {
      padding: 2.5rem 3rem 1.5rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    header h1 {
      margin: 0;
      font-size: 2.25rem;
      letter-spacing: -0.02em;
    }

    nav a {
      color: #f8fafc;
      text-decoration: none;
      font-weight: 600;
      margin-right: 1rem;
    }

    nav a:last-child {
      margin-right: 0;
    }

    main {
      padding: 0 3rem 3rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .card {
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
      backdrop-filter: blur(14px);
    }

    .card h2 {
      margin-top: 0;
      font-size: 1.5rem;
    }

    label { display: block; margin-bottom: 0.75rem; font-size: 0.95rem; }
    label span { display: block; margin-bottom: 0.25rem; font-weight: 600; }

    input[type="text"],
    input[type="url"],
    input[type="date"],
    textarea,
    select {
      width: 100%;
      padding: 0.65rem 0.75rem;
      border-radius: 10px;
      border: 1px solid rgba(148, 163, 184, 0.4);
      background: rgba(15, 23, 42, 0.8);
      color: inherit;
      font-size: 0.95rem;
    }

    textarea { min-height: 160px; resize: vertical; }

    button {
      appearance: none;
      border: none;
      background: linear-gradient(135deg, #38bdf8, #6366f1);
      color: #0f172a;
      font-weight: 700;
      padding: 0.85rem 1.4rem;
      border-radius: 999px;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    button:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(56, 189, 248, 0.35);
    }

    .row { display: flex; flex-wrap: wrap; gap: 1.5rem; }
    .row > div { flex: 1 1 300px; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      border-radius: 14px;
      overflow: hidden;
    }

    th, td {
      border-bottom: 1px solid rgba(148, 163, 184, 0.15);
      padding: 0.85rem 1rem;
      text-align: left;
      vertical-align: top;
      font-size: 0.95rem;
    }

    th {
      background: rgba(15, 23, 42, 0.65);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(226, 232, 240, 0.7);
    }

    tr:last-child td { border-bottom: none; }

    code {
      background: rgba(15, 23, 42, 0.7);
      padding: 0.15rem 0.4rem;
      border-radius: 6px;
      font-size: 0.9rem;
    }

    a { color: #38bdf8; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .stat {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.2rem;
      border-radius: 14px;
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .stat span:first-child {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(226, 232, 240, 0.65);
    }

    .stat strong {
      font-size: 1.6rem;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .status-held { background: rgba(251, 191, 36, 0.18); color: #fde68a; }
    .status-published { background: rgba(34, 197, 94, 0.18); color: #bbf7d0; }
    .status-failed { background: rgba(248, 113, 113, 0.18); color: #fecaca; }

    .queue-list {
      display: grid;
      gap: 1rem;
      margin-top: 1.2rem;
    }

    .queue-item {
      padding: 1.1rem 1.25rem;
      border-radius: 14px;
      border: 1px solid rgba(148, 163, 184, 0.16);
      background: rgba(15, 23, 42, 0.7);
      display: grid;
      gap: 0.5rem;
    }

    .queue-item h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .queue-meta { font-size: 0.85rem; color: rgba(226, 232, 240, 0.8); }
    .missing-list { margin: 0.5rem 0 0; padding-left: 1.1rem; }

    .inline-list { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .inline-list span { background: rgba(148, 163, 184, 0.22); padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.8rem; }

    .muted { color: rgba(226, 232, 240, 0.65); font-size: 0.9rem; }

    @media (max-width: 720px) {
      header, main { padding: 1.5rem; }
      .row { flex-direction: column; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Job Poster</h1>
    <nav>
      <a href="/">Home</a> ·
      <a href="/admin/holds">Held Jobs</a> ·
      <a href="/admin/hosted">Hosted Pages</a>
    </nav>
  </header>
  <main>
    <%- body %>
  </main>
</body>
</html>
