<section class="card">
  <h2>Ingest Job Posting</h2>
  <form method="post" action="/ingest">
    <label>Job URL
      <input type="url" name="url" placeholder="https://example.com/job" required />
    </label>
    <button type="submit">Extract & Review</button>
  </form>
</section>

<section class="card">
  <h2>API Overview</h2>
